{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run lint:*)",
      "Bash(npx vitest run:*)",
      "Bash(gh api repos/:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(python3:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(rtk git add:*)",
      "Bash(rtk git commit:*)",
      "Bash(rtk git status:*)",
      "Bash(rtk git diff:*)",
      "Bash(rtk git log:*)",
      "Bash(rtk ls:*)",
      "Bash(rtk cat:*)",
      "Bash(cp scripts/ait-snapshot.plist:*)",
      "Bash(launchctl load:*)",
      "Bash(launchctl list:*)"
    ],
    "deny": [
      "Read(./config/channels.json)",
      "Read(./.env)"
    ]
  }
}
