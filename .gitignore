.DS_Store
.gstack/
.env
.env.local
node_modules/
__pycache__/
.logs/

# Tool caches. Both already self-ignore with a `*` file they write inside themselves;
# listed here so the exclusion survives a tool that stops doing that.
.pytest_cache/
.ruff_cache/

# Coverage artifacts, written by scripts/coverage.sh. Regenerable in under two seconds.
.coverage
htmlcov/

# The private roster. Copy config/channels.example.json to start one.
config/channels.json

# The three data layers. Written by the pipeline, never by hand.
# Contents are ignored; the README explaining each layer is not.
_raw/*
!_raw/README.md
_synthesize/*
!_synthesize/README.md
_db/*
!_db/README.md

# Mockup screenshots. Regenerable from the HTML with `node docs/mockups/shoot.mjs`,
# a few MB each, so the folder and its README are tracked and the PNGs are not.
docs/mockups/screenshots/*
!docs/mockups/screenshots/README.md
.superpowers/
